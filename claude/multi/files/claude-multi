#!/usr/bin/env bash
#
# claude-multi — run multiple Claude Code accounts on one machine with
# isolated auth/identity but SHARED, resumable session history.
#
# Each profile gets a private ~/.claude + ~/.claude.json (creds, settings,
# history). Selected subdirectories (default: projects) are then overlaid
# with bind mounts pointing at common shared storage, so a session created
# under profile A can be resumed under profile B.
#
# Isolation is done with bwrap bind mounts over the real canonical paths —
# NO symlinks, NO CLAUDE_CONFIG_DIR, NO sandbox-HOME swap. Claude sees its
# normal ~/.claude and ~/.claude.json.
#
# This file is installed by claude/multi/install.sh and is also usable
# standalone (it falls back to sensible defaults when no config is present).

set -euo pipefail

# ---------------------------------------------------------------------------
# Config (persisted by install.sh, reused on update / reinstall)
# ---------------------------------------------------------------------------
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"

CONFIG_FILE="$XDG_CONFIG_HOME/claude-multi/config"
# shellcheck disable=SC1090
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# Root of all multi-account state.
: "${CLAUDE_MULTI_ROOT:=$XDG_DATA_HOME/claude-multi}"
# Space-separated list of ~/.claude subdirectories to share across profiles.
# Default is conservative: only resumable transcripts. You may add e.g.
# "projects file-history session-env" for higher-fidelity cross-account resume.
: "${CLAUDE_MULTI_SHARED:=projects}"
# Give each profile a private, disposable ~/.cache (1=on, 0=off).
: "${CLAUDE_MULTI_CACHE:=1}"
# Extra host paths to expose writable (space-separated, bound to themselves).
# e.g. CLAUDE_MULTI_WRITABLE="$HOME/.npm $HOME/.cargo"
: "${CLAUDE_MULTI_WRITABLE:=}"
# Expose $XDG_RUNTIME_DIR writable (ssh-agent / keyring sockets). 1=on, 0=off.
: "${CLAUDE_MULTI_RUNTIME_DIR:=1}"
# Name of the claude binary to launch inside the sandbox.
: "${CLAUDE_MULTI_BIN:=claude}"
# Auto-confirm destructive actions (used by install bootstrap / scripts).
: "${CLAUDE_MULTI_YES:=0}"
# Where `auto create` writes claude-<name> wrappers.
: "${CLAUDE_MULTI_BIN_DIR:=$HOME/.local/bin}"
BIN_DIR="$CLAUDE_MULTI_BIN_DIR"
# Auto (virtual) profile state — see "Auto profiles" below.
AUTO_DIR="$XDG_CONFIG_HOME/claude-multi/auto"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

PROFILES_DIR="$CLAUDE_MULTI_ROOT/profiles"
SHARED_DIR="$CLAUDE_MULTI_ROOT/shared"
LOCK_DIR="$SHARED_DIR/.locks"

# Runtime-coordination dirs that must NEVER be shared or imported into a
# private profile (they are PID/host/daemon scoped).
RUNTIME_DIRS="sessions jobs daemon ide"

err()  { printf '[claude-multi] %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

require_bwrap() {
  command -v bwrap >/dev/null 2>&1 || die "bwrap (bubblewrap) not found. Install it (e.g. 'pacman -S bubblewrap' / 'apt install bubblewrap')."
}

# confirm "<question>" — returns 0 on yes. Honors CLAUDE_MULTI_YES=1; otherwise
# prompts on the terminal (via /dev/tty so it works under `curl ... | bash`).
# With no terminal and no CLAUDE_MULTI_YES, it refuses (safe default).
confirm() {
  if [ "$CLAUDE_MULTI_YES" = "1" ]; then
    echo "$1 -> yes (CLAUDE_MULTI_YES=1)"
    return 0
  fi
  local reply=""
  if { exec 3<>/dev/tty; } 2>/dev/null; then
    printf '%s [y/N] ' "$1" >&3
    read -r reply <&3 || reply=""
    exec 3>&- 3<&- 2>/dev/null || true
  elif [ -t 0 ]; then
    printf '%s [y/N] ' "$1"
    read -r reply || reply=""
  else
    err "no terminal available to confirm. Re-run interactively or set CLAUDE_MULTI_YES=1."
    return 1
  fi
  case "$reply" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

valid_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_.-]*) return 1 ;;
    .|..) return 1 ;;
    *) return 0 ;;
  esac
}

# ---------------------------------------------------------------------------
# Profile creation / migration
# ---------------------------------------------------------------------------
ensure_shared() {
  mkdir -p "$SHARED_DIR"
  chmod 700 "$SHARED_DIR" 2>/dev/null || true
  local n
  for n in $CLAUDE_MULTI_SHARED; do
    valid_name "$n" || die "invalid shared subdir name: '$n'"
    case " $RUNTIME_DIRS " in
      *" $n "*) err "WARNING: sharing runtime dir '$n' is unsafe and may corrupt state." ;;
    esac
    mkdir -p "$SHARED_DIR/$n"
    chmod 700 "$SHARED_DIR/$n" 2>/dev/null || true
  done
}

# The global config file lives at $CLAUDE_CONFIG_DIR/.claude.json. We set
# CLAUDE_CONFIG_DIR=$HOME/.claude inside the sandbox so .claude.json sits INSIDE
# the bound .claude directory. This is required because Claude Code saves
# .claude.json with an atomic temp-file + rename(), which fails with EBUSY over a
# single-file bind mount — so a top-level ~/.claude.json bind silently never
# persists (account identity/oauthAccount freezes). Isolation is still done by
# the directory bind; CLAUDE_CONFIG_DIR only relocates the file into it.
ensure_profile_config() {
  local p="$1"
  mkdir -p "$p/.claude"
  # Migrate legacy layout ($p/.claude.json) into $p/.claude/.claude.json.
  if [ -f "$p/.claude.json" ]; then
    if [ ! -f "$p/.claude/.claude.json" ]; then
      mv "$p/.claude.json" "$p/.claude/.claude.json"
    else
      rm -f "$p/.claude.json"   # new layout already present; drop the stale copy
    fi
  fi
  if [ ! -e "$p/.claude/.claude.json" ]; then
    printf '{}' > "$p/.claude/.claude.json"
  fi
  chmod 600 "$p/.claude/.claude.json" 2>/dev/null || true
}

init_profile() {
  local name="$1"
  valid_name "$name" || die "invalid profile name: '$name'"
  local p="$PROFILES_DIR/$name"
  mkdir -p "$p/.claude"
  chmod 700 "$p" "$p/.claude" 2>/dev/null || true
  ensure_profile_config "$p"
  if [ "$CLAUDE_MULTI_CACHE" = "1" ]; then
    mkdir -p "$p/cache"
    chmod 700 "$p/cache" 2>/dev/null || true
  fi
  ensure_shared
  echo "Initialized profile '$name' at $p"
}

import_profile() {
  local name="" from="$HOME" force=0 seed=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="${2:-}"; shift 2 ;;
      --from=*) from="${1#--from=}"; shift ;;
      --force) force=1; shift ;;
      --seed-shared) seed=1; shift ;;
      --*) die "unknown import option: $1" ;;
      *) [ -z "$name" ] && name="$1" || die "unexpected argument: $1"; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: claude-multi import <profile> [--from DIR] [--force] [--seed-shared]"
  valid_name "$name" || die "invalid profile name: '$name'"
  [ -d "$from/.claude" ] || die "no .claude found under '$from'"

  init_profile "$name" >/dev/null
  local p="$PROFILES_DIR/$name"

  if [ -s "$p/.claude/.credentials.json" ] && [ "$force" != 1 ]; then
    die "profile '$name' already has credentials. Re-run with --force to overwrite."
  fi

  echo "Importing from $from/.claude -> $p/.claude (private state only)"
  # Copy everything, then prune shared + runtime dirs out of the private copy.
  cp -a "$from/.claude/." "$p/.claude/" 2>/dev/null || true
  local ex
  for ex in $CLAUDE_MULTI_SHARED $RUNTIME_DIRS; do
    rm -rf "${p:?}/.claude/$ex"
  done
  # The source's global config is at $from/.claude.json (or, if that home used
  # CLAUDE_CONFIG_DIR, $from/.claude/.claude.json). Place it INSIDE .claude.
  if [ -f "$from/.claude.json" ]; then
    cp -a "$from/.claude.json" "$p/.claude/.claude.json"
  fi
  rm -f "$p/.claude.json"   # never keep the legacy top-level copy
  ensure_profile_config "$p"
  chmod 600 "$p/.claude/.claude.json" 2>/dev/null || true
  chmod -R u+rwX,go-rwx "$p/.claude" 2>/dev/null || true

  if [ "$seed" = 1 ]; then
    local n
    for n in $CLAUDE_MULTI_SHARED; do
      if [ -d "$from/.claude/$n" ] && [ -z "$(ls -A "$SHARED_DIR/$n" 2>/dev/null)" ]; then
        echo "Seeding shared '$n' from $from/.claude/$n"
        cp -a "$from/.claude/$n/." "$SHARED_DIR/$n/" 2>/dev/null || true
      fi
    done
  fi
  echo "Done. Private creds/settings imported; shared dirs ($CLAUDE_MULTI_SHARED) left to the shared store."
}

# ---------------------------------------------------------------------------
# Link shared subdirs to the main (non-sandboxed) ~/.claude so profiles AND the
# normal `claude` share the same storage. bwrap resolves the symlinked bind
# source on the host, so sessions resume across all of them.
#
# Every removal is reported and confirmed first (see confirm()). Existing
# content is merged into main non-destructively (cp -an) before the shared dir
# is replaced by a symlink, so nothing is lost.
# ---------------------------------------------------------------------------
# Print relative paths under $1 (shared dir) that would be LOST if $1 were
# removed after `cp -an $1 $2` — i.e. files that collide with a DIFFERENT file
# already in $2 (main). Files unique to shared copy cleanly and are not at risk.
at_risk_files() {
  local sdir="$1" mdir="$2" rel
  [ -d "$sdir" ] || return 0
  ( cd "$sdir" && find . -type f -print 2>/dev/null ) | while IFS= read -r rel; do
    rel="${rel#./}"
    if [ -e "$mdir/$rel" ] && ! cmp -s "$sdir/$rel" "$mdir/$rel"; then
      printf '%s\n' "$rel"
    fi
  done
}

link_main() {
  local names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) CLAUDE_MULTI_YES=1; shift ;;
      --all)    names=($CLAUDE_MULTI_SHARED); shift ;;
      --*)      die "unknown link-main option: $1" ;;
      *)        names+=("$1"); shift ;;
    esac
  done
  [ ${#names[@]} -eq 0 ] && names=($CLAUDE_MULTI_SHARED)
  ensure_shared

  local do_link=() risky=() n link target r
  for n in "${names[@]}"; do
    valid_name "$n" || die "invalid subdir name: '$n'"
    link="$SHARED_DIR/$n"; target="$HOME/.claude/$n"
    if [ -L "$link" ] && [ "$(readlink -f "$link")" = "$(readlink -f "$target")" ]; then
      echo "already linked: shared/$n -> $target"
      continue
    fi
    do_link+=("$n")
    # Only a real directory with colliding, differing files risks data loss;
    # a symlink is just a pointer, and unique files merge losslessly (cp -an).
    if [ ! -L "$link" ] && [ -d "$link" ]; then
      while IFS= read -r r; do [ -n "$r" ] && risky+=("$n/$r"); done < <(at_risk_files "$link" "$target")
    fi
  done

  if [ ${#do_link[@]} -eq 0 ]; then echo "Nothing to do."; return 0; fi

  # Confirm ONLY if something would actually be lost.
  if [ ${#risky[@]} -gt 0 ]; then
    echo "WARNING: these shared files differ from an existing file in ~/.claude and"
    echo "would be LOST (main's version is kept):"
    for r in "${risky[@]}"; do echo "  shared/$r"; done
    confirm "Link anyway, dropping the above?" || { echo "Aborted — nothing changed."; return 1; }
  fi

  for n in "${do_link[@]}"; do
    link="$SHARED_DIR/$n"; target="$HOME/.claude/$n"
    mkdir -p "$target"
    if [ ! -L "$link" ] && [ -d "$link" ] && [ -n "$(ls -A "$link" 2>/dev/null)" ]; then
      cp -an "$link/." "$target/" 2>/dev/null || true   # non-destructive merge
    fi
    rm -rf "$link"
    ln -s "$target" "$link"
    echo "linked: shared/$n -> $target"
  done
}

# Detaching never loses data (it lives in main); no confirmation needed.
unlink_main() {
  local names=() copy=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) shift ;;              # accepted, no-op (nothing to confirm)
      --copy)   copy=1; shift ;;
      --all)    names=($CLAUDE_MULTI_SHARED); shift ;;
      --*)      die "unknown unlink-main option: $1" ;;
      *)        names+=("$1"); shift ;;
    esac
  done
  [ ${#names[@]} -eq 0 ] && names=($CLAUDE_MULTI_SHARED)

  local n link target
  for n in "${names[@]}"; do
    valid_name "$n" || die "invalid subdir name: '$n'"
    link="$SHARED_DIR/$n"
    if [ ! -L "$link" ]; then echo "not linked (skipping): shared/$n"; continue; fi
    target="$(readlink -f "$link")"
    rm -f "$link"
    mkdir -p "$link"; chmod 700 "$link" 2>/dev/null || true
    if [ "$copy" = 1 ] && [ -d "$target" ]; then
      cp -an "$target/." "$link/" 2>/dev/null || true
    fi
    echo "detached: shared/$n is now an independent directory"
  done
}

# ---------------------------------------------------------------------------
# Sandbox launch
# ---------------------------------------------------------------------------
# Detect an explicit --resume/-r <uuid> so we can guard against two profiles
# attaching to the same session concurrently. Best-effort; only exact UUIDs.
detect_resume_uuid() {
  local prev="" a
  for a in "$@"; do
    case "$prev" in --resume|-r) printf '%s' "$a"; return ;; esac
    case "$a" in
      --resume=*) printf '%s' "${a#--resume=}"; return ;;
    esac
    prev="$a"
  done
}

# launch_in <profile> <command> [args...]
launch_in() {
  local name="$1"; shift
  valid_name "$name" || die "invalid profile name: '$name'"
  local p="$PROFILES_DIR/$name"
  [ -d "$p/.claude" ] || die "profile '$name' not initialized. Run: claude-multi init $name  (or: import $name)"
  ensure_profile_config "$p"
  require_bwrap
  ensure_shared

  # IMPORTANT: bwrap applies binds in order; a later bind mounted over an
  # ancestor path SHADOWS earlier binds beneath it. The working tree, writable
  # passthroughs and $XDG_RUNTIME_DIR may live under (or BE) $HOME, so they must
  # be bound BEFORE the per-profile ~/.claude binds — otherwise running the
  # wrapper from $HOME (e.g. `cd ~; claude-a`, or over ssh whose cwd is $HOME)
  # re-exposes the real ~/.claude and ~/.claude.json to every profile, breaking
  # account isolation. Profile state goes on top; shared overlays last.
  local args=(
    --ro-bind / /
    --proc /proc
    --dev /dev
    --tmpfs /tmp
  )
  # Writable working tree (may be / overlap $HOME) — bind FIRST.
  args+=( --bind "$PWD" "$PWD" )
  # Extra writable passthroughs (may live under $HOME).
  local w
  for w in $CLAUDE_MULTI_WRITABLE; do
    [ -e "$w" ] && args+=( --bind "$w" "$w" )
  done
  # ssh-agent / keyring sockets.
  if [ "$CLAUDE_MULTI_RUNTIME_DIR" = "1" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    args+=( --bind "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR" )
  fi
  # Private account state — bound ON TOP of anything above (incl. a $HOME cwd).
  # Only the .claude DIRECTORY is bound; .claude.json lives inside it (via
  # CLAUDE_CONFIG_DIR below), so atomic saves work and identity persists.
  args+=( --bind "$p/.claude" "$HOME/.claude" )
  # Profile-local disposable cache.
  if [ "$CLAUDE_MULTI_CACHE" = "1" ]; then
    mkdir -p "$p/cache"
    args+=( --bind "$p/cache" "$HOME/.cache" )
  fi
  # Shared subdirs overlaid ON TOP of the private .claude — bound LAST.
  local n
  for n in $CLAUDE_MULTI_SHARED; do
    args+=( --bind "$SHARED_DIR/$n" "$HOME/.claude/$n" )
  done

  args+=(
    --die-with-parent
    --setenv TMPDIR /tmp
    --setenv CLAUDE_CONFIG_DIR "$HOME/.claude"
    --unsetenv ANTHROPIC_API_KEY
    --unsetenv ANTHROPIC_AUTH_TOKEN
    --unsetenv CLAUDE_CODE_OAUTH_TOKEN
    --unsetenv ANTHROPIC_BASE_URL
    --unsetenv CLAUDE_CODE_USE_BEDROCK
    --unsetenv CLAUDE_CODE_USE_VERTEX
    --unsetenv CLAUDE_CODE_USE_FOUNDRY
  )

  exec bwrap "${args[@]}" "$@"
}

run_profile() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: claude-multi run <profile|auto> [claude args...]"
  shift
  name="$(resolve_profile "$name")" || exit 1
  local uuid; uuid="$(detect_resume_uuid "$@")"
  if [ -n "$uuid" ]; then
    mkdir -p "$LOCK_DIR" 2>/dev/null || true; chmod 700 "$LOCK_DIR" 2>/dev/null || true
    # Hold the lock for the lifetime of the launched process (fd stays open
    # across exec). Best-effort guard against concurrent same-UUID resume — an
    # unwritable lock dir (e.g. launched from inside another claude-multi
    # sandbox, where the state root is read-only) must not block the launch.
    if { exec 9>"$LOCK_DIR/$uuid.lock"; } 2>/dev/null; then
      if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
        die "session $uuid is already attached in another profile/process. Refusing concurrent resume."
      fi
    else
      err "warning: cannot create $LOCK_DIR/$uuid.lock; skipping the concurrent-resume guard."
    fi
  fi
  launch_in "$name" "$CLAUDE_MULTI_BIN" "$@"
}

# exec_profile <profile> -- <command...>   (run an arbitrary command sandboxed)
exec_profile() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: claude-multi exec <profile|auto> -- <command...>"
  shift
  name="$(resolve_profile "$name")" || exit 1
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "no command given"
  launch_in "$name" "$@"
}

# ---------------------------------------------------------------------------
# Auto profiles: a virtual profile mapped onto real ones
# ---------------------------------------------------------------------------
# An auto profile (e.g. "auto" -> vcf-2 vcf-4) has no account of its own; it
# points at ONE of its member profiles (its "active" member). `run <auto>` and
# its wrapper claude-<auto> resolve that member at LAUNCH time, because a
# running Claude keeps the account it started with. `switch <auto>` moves the
# pointer and (when Paseo is installed) restarts the idle Paseo agents on the
# provider claude-<auto>, which resume the same session under the new account.
#
# State: $AUTO_DIR/<name>, plain "key=value" lines (never sourced):
#   profiles=vcf-2 vcf-4
#   active=vcf-2

auto_file()  { printf '%s/%s\n' "$AUTO_DIR" "$1"; }
is_auto()    { valid_name "$1" && [ -f "$(auto_file "$1")" ]; }
is_profile() { valid_name "$1" && [ -d "$PROFILES_DIR/$1/.claude" ]; }
# Logged in = a non-blank OAuth refresh/access token (a failed refresh leaves
# the file in place with the tokens blanked).
logged_in()  { grep -qE '"(refreshToken|accessToken)" *: *"[^"]' "$PROFILES_DIR/$1/.claude/.credentials.json" 2>/dev/null; }

# auto_get <name> <key>
auto_get() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$2="*) printf '%s\n' "${line#"$2="}"; return 0 ;; esac
  done < "$(auto_file "$1")"
}

# auto_put <name> <profiles> <active>   (atomic: a concurrent launch sees old or new)
auto_put() {
  mkdir -p "$AUTO_DIR"; chmod 700 "$AUTO_DIR" 2>/dev/null || true
  local f; f="$(auto_file "$1")"
  printf '# claude-multi auto profile (managed by: claude-multi auto / switch)\nprofiles=%s\nactive=%s\n' "$2" "$3" > "$f.tmp.$$"
  mv -f "$f.tmp.$$" "$f"
}

list_autos() {
  local f
  [ -d "$AUTO_DIR" ] || return 0
  for f in "$AUTO_DIR"/*; do
    [ -f "$f" ] && valid_name "$(basename "$f")" && basename "$f"
  done
  return 0
}

# Print the real profile an auto currently maps to: its active member if that
# is still a valid member, else the first initialized member.
auto_resolve() {
  local name="$1" act members m
  is_auto "$name" || die "no such auto profile: '$name'"
  act="$(auto_get "$name" active)"; members="$(auto_get "$name" profiles)"
  if [ -n "$act" ] && case " $members " in *" $act "*) true ;; *) false ;; esac && is_profile "$act"; then
    printf '%s\n' "$act"; return 0
  fi
  for m in $members; do
    if is_profile "$m"; then
      [ -n "$act" ] && err "auto '$name': active '$act' is not a usable member; using '$m'."
      printf '%s\n' "$m"; return 0
    fi
  done
  die "auto '$name' has no initialized member profiles ($members)."
}

# Map a run target to a real profile (autos resolve; real names pass through).
resolve_profile() {
  if is_auto "$1"; then
    is_profile "$1" && die "'$1' is both a profile and an auto profile; remove one."
    auto_resolve "$1"
  else
    printf '%s\n' "$1"
  fi
}

# (Re)write ~/.local/bin/claude-<name>. Never clobbers a file we didn't make.
write_auto_wrapper() {
  local name="$1" w="$BIN_DIR/claude-$1"
  if [ -e "$w" ] && ! grep -q '^# vh-tricks claude/multi' "$w" 2>/dev/null; then
    err "not overwriting $w (not a claude-multi wrapper)."; return 0
  fi
  mkdir -p "$BIN_DIR"
  cat > "$w" <<EOW
#!/usr/bin/env bash
# vh-tricks claude/multi — launch Claude Code as auto profile '$name' (follows 'claude-multi switch $name')
exec "$SELF" run "$name" "\$@"
EOW
  chmod +x "$w"
  echo "Wrapper: $w"
}

# auto create <name> [profiles...]   (idempotent; no profiles = keep current set)
auto_create() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: claude-multi auto create <name> [profiles...]"
  shift
  valid_name "$name" || die "invalid auto profile name: '$name'"
  case "$name" in multi) die "'multi' is reserved (claude-multi)." ;; esac
  is_profile "$name" && die "'$name' is already a real profile; pick another auto name."
  local list=("$@") members m act=""
  if [ ${#list[@]} -eq 0 ]; then
    if is_auto "$name"; then members="$(auto_get "$name" profiles)"; else members="${CLAUDE_MULTI_PROFILES:-}"; fi
    read -r -a list <<< "$members"
  fi
  [ ${#list[@]} -gt 0 ] || die "auto '$name' needs at least one member profile."
  members="${list[*]}"
  for m in "${list[@]}"; do
    valid_name "$m" || die "invalid member profile name: '$m'"
    is_auto "$m" && die "member '$m' is an auto profile; members must be real profiles."
    is_profile "$m" || die "member '$m' is not an initialized profile. Run: claude-multi init $m"
  done
  is_auto "$name" && act="$(auto_get "$name" active)"
  case " $members " in *" $act "*) [ -n "$act" ] || act="${members%% *}" ;; *) act="${members%% *}" ;; esac
  auto_put "$name" "$members" "$act"
  echo "Auto profile '$name' -> [$members], active: $act"
  write_auto_wrapper "$name"
}

auto_rm() {
  local name="${1:-}"; is_auto "$name" || die "no such auto profile: '$name'"
  rm -f "$(auto_file "$name")"
  local w="$BIN_DIR/claude-$name"
  if [ -f "$w" ] && grep -q "^exec .* run \"$name\"" "$w" 2>/dev/null; then rm -f "$w"; echo "Removed $w"; fi
  echo "Removed auto profile '$name'. (Paseo agents on claude-$name will fail to launch until re-pointed.)"
}

auto_list() {
  local a any=0
  while IFS= read -r a; do
    [ -n "$a" ] || continue; any=1
    printf '  - %-12s -> %-12s [%s]\n' "$a" "$(auto_resolve "$a" 2>/dev/null || echo '?')" "$(auto_get "$a" profiles)"
  done < <(list_autos)
  [ "$any" = 1 ] || echo "  (none)  create one: claude-multi auto create auto <profile...>"
}

auto_cmd() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    create|set|add) auto_create "$@" ;;
    rm|remove|delete) auto_rm "$@" ;;
    list|ls) echo "Auto profiles:"; auto_list ;;
    *) die "usage: claude-multi auto [list | create <name> [profiles...] | rm <name>]" ;;
  esac
}

# Next logged-in member after $2 in auto $1's order (wraps around).
next_member() {
  local name="$1" cur="$2" list=() i n start=0
  read -r -a list <<< "$(auto_get "$name" profiles)"
  for i in "${!list[@]}"; do [ "${list[$i]}" = "$cur" ] && start=$((i + 1)); done
  for ((i = 0; i < ${#list[@]}; i++)); do
    n="${list[$(((start + i) % ${#list[@]}))]}"
    [ "$n" = "$cur" ] && continue
    is_profile "$n" && logged_in "$n" && { printf '%s\n' "$n"; return 0; }
  done
  die "auto '$name': no other logged-in member to switch to (current: $cur)."
}

# Restart IDLE Paseo agents on provider $1 so they relaunch under the new
# account (`paseo agent reload` resumes the same session id). Running agents
# are never touched — reload cancels an in-flight turn; they keep the old
# account until their next restart (re-run `switch <auto> --reload` later).
paseo_reload_idle() {
  local provider="$1"
  command -v paseo >/dev/null 2>&1 || { echo "paseo not found; skipping agent reload."; return 0; }
  command -v jq >/dev/null 2>&1 || { err "jq not found; skipping paseo agent reload."; return 0; }
  local json
  json="$(paseo ls -g --json 2>/dev/null)" || { err "paseo ls failed (daemon down?); skipping reload."; return 0; }
  local id status label busy=0 done_n=0
  while IFS=$'\t' read -r id status label; do
    [ -n "$id" ] || continue
    if [ "$status" != idle ]; then
      echo "  skip    ${id:0:8} ($status) $label"; busy=$((busy + 1)); continue
    fi
    if paseo agent reload "$id" >/dev/null 2>&1; then
      echo "  reload  ${id:0:8} $label"; done_n=$((done_n + 1))
    else
      err "  reload FAILED for ${id:0:8} ($label)"
    fi
  done < <(printf '%s' "$json" | jq -r --arg p "$provider/" \
      '.[] | select((.provider // "") | startswith($p)) | [.id, .status, ((.name // "") | .[0:50])] | @tsv')
  if [ $((done_n + busy)) -eq 0 ]; then
    # Nothing to do is usually a setup gap, not success: say where agents are.
    local others
    others="$(printf '%s' "$json" | jq -r '[.[] | (.provider // "?") | split("/")[0]] | group_by(.)
      | map("\(.[0]) (\(length))") | join(", ")')"
    echo "Paseo: no agents on provider '$provider', so none were reloaded."
    [ -n "$others" ] && echo "  Agents are on: $others (these do not follow 'switch')."
    echo "  Add a '$provider' provider to ~/.paseo/config.json and create/import agents on it."
    return 0
  fi
  echo "Paseo '$provider': reloaded $done_n idle agent(s); left $busy busy agent(s) alone."
}

# switch [auto] [profile] [--reload|--no-reload]
#   auto defaults to the only auto profile; no profile = rotate to the next
#   logged-in member.
switch_profile() {
  local pos=() reload=auto
  while [ $# -gt 0 ]; do
    case "$1" in
      --reload)    reload=1; shift ;;
      --no-reload) reload=0; shift ;;
      --*) die "unknown switch option: $1" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  local name="" target=""
  if [ ${#pos[@]} -gt 0 ] && is_auto "${pos[0]}"; then
    name="${pos[0]}"; target="${pos[1]:-}"
    [ ${#pos[@]} -le 2 ] || die "usage: claude-multi switch [auto] [profile]"
  else
    [ ${#pos[@]} -le 1 ] || die "'${pos[0]}' is not an auto profile."
    local autos; autos="$(list_autos)"
    [ -n "$autos" ] || die "no auto profiles. Create one: claude-multi auto create auto <profile...>"
    [ "$(printf '%s\n' "$autos" | wc -l)" -eq 1 ] || die "several auto profiles; name one: claude-multi switch <auto> [profile]"
    name="$autos"; target="${pos[0]:-}"
  fi
  local cur; cur="$(auto_resolve "$name")" || exit 1
  if [ -z "$target" ]; then
    target="$(next_member "$name" "$cur")" || exit 1
  else
    case " $(auto_get "$name" profiles) " in
      *" $target "*) ;;
      *) die "'$target' is not a member of auto '$name' ($(auto_get "$name" profiles))." ;;
    esac
    is_profile "$target" || die "profile '$target' not initialized."
    logged_in "$target" || die "profile '$target' is not logged in. Run: claude-multi run $target  then /login"
  fi
  auto_put "$name" "$(auto_get "$name" profiles)" "$target"
  if [ "$cur" = "$target" ]; then echo "$name -> $target (unchanged)"; else echo "$name: $cur -> $target"; fi
  if [ "$reload" = 1 ] || { [ "$reload" = auto ] && command -v paseo >/dev/null 2>&1; }; then
    paseo_reload_idle "claude-$name"
  fi
}

# ---------------------------------------------------------------------------
# Quota (subscription usage limits)
# ---------------------------------------------------------------------------
# Reads each profile's usage the same way Claude Code's /usage does: GET
# $QUOTA_URL with the profile's OAuth access token. Read-only: it never
# refreshes tokens (a refresh rotates the refresh token and could log out a
# running Claude on that profile). An expired token is reported as such; it is
# refreshed the next time Claude runs on that profile.
QUOTA_URL="${CLAUDE_MULTI_QUOTA_URL:-https://api.anthropic.com/api/oauth/usage}"

# quota_fetch <profile> — print ONE JSON object for the profile (never fails).
quota_fetch() {
  local name="$1" c="$PROFILES_DIR/$1/.claude/.credentials.json" tok="" out code
  [ -f "$c" ] && tok="$(jq -r '.claudeAiOauth.accessToken // empty' "$c" 2>/dev/null)" || true
  if [ -z "$tok" ]; then
    jq -n --arg p "$name" '{profile: $p, status: "logged_out",
      error: "no OAuth token; run: claude-multi run \($p)  then /login"}'
    return 0
  fi
  # Header via stdin (printf is a builtin): the token never appears in argv.
  out="$(printf 'Authorization: Bearer %s\nanthropic-beta: oauth-2025-04-20\n' "$tok" \
    | curl -sS -m 15 -H @- -w '\n%{http_code}' "$QUOTA_URL" 2>&1)" || true
  code="${out##*$'\n'}"; out="${out%$'\n'*}"
  case "$code" in
    200)
      printf '%s' "$out" | jq --arg p "$name" '
        def win: if . == null then null else
          { percent: .utilization, resets_at: .resets_at,
            resets_in_s: (try ((.resets_at | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z")
                                | fromdateiso8601) - now | floor) catch null) } end;
        { profile: $p, status: "ok",
          five_hour: (.five_hour | win), seven_day: (.seven_day | win),
          limits: (.limits // []) }' 2>/dev/null \
        || jq -n --arg p "$name" '{profile: $p, status: "error", error: "unexpected response from usage endpoint"}'
      ;;
    401|403)
      jq -n --arg p "$name" '{profile: $p, status: "auth_expired",
        error: "token expired or revoked; it refreshes the next time Claude runs on \($p) (or /login)"}' ;;
    *)
      jq -n --arg p "$name" --arg c "$code" --arg m "${out:0:200}" \
        '{profile: $p, status: "error", error: "usage endpoint: HTTP \($c) \($m)"}' ;;
  esac
}

# All initialized profiles: configured order first, then any other profile dir.
all_profiles() {
  local seen=" " n d
  for n in ${CLAUDE_MULTI_PROFILES:-}; do
    is_profile "$n" || continue
    case "$seen" in *" $n "*) continue ;; esac
    seen="$seen$n "; printf '%s\n' "$n"
  done
  for d in "$PROFILES_DIR"/*/; do
    [ -d "$d.claude" ] || continue
    n="$(basename "$d")"
    case "$seen" in *" $n "*) continue ;; esac
    seen="$seen$n "; printf '%s\n' "$n"
  done
}

# "in 2h05m" / "in 3d4h" for a number of seconds.
fmt_in() {
  local s="${1:-}"
  case "$s" in ''|null) printf '-'; return ;; esac
  [ "$s" -le 0 ] && { printf 'now'; return; }
  local d=$((s / 86400)) h=$((s % 86400 / 3600)) m=$((s % 3600 / 60))
  if [ "$d" -gt 0 ]; then printf 'in %dd%dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf 'in %dh%02dm' "$h" "$m"
  else printf 'in %dm' "$m"; fi
}

# quota [profile|auto ...] [--json]
quota_cmd() {
  local json=0 names=() n m
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --*) die "unknown quota option: $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done
  command -v curl >/dev/null 2>&1 || die "curl is required for quota."
  command -v jq >/dev/null 2>&1 || die "jq is required for quota."
  # Default: every profile. An auto profile expands to its members.
  local targets=()
  if [ ${#names[@]} -eq 0 ]; then
    while IFS= read -r n; do [ -n "$n" ] && targets+=("$n"); done < <(all_profiles)
  else
    for n in "${names[@]}"; do
      if is_auto "$n"; then
        for m in $(auto_get "$n" profiles); do targets+=("$m"); done
      else
        is_profile "$n" || die "no such profile or auto profile: '$n'"
        targets+=("$n")
      fi
    done
  fi
  [ ${#targets[@]} -gt 0 ] || die "no profiles. Run: claude-multi init <profile>"

  # Which autos currently point at each profile (shown as "active: auto").
  local a map='{}'
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    m="$(auto_resolve "$a" 2>/dev/null)" || continue
    map="$(jq -c --arg p "$m" --arg a "$a" '.[$p] += [$a]' <<< "$map")"
  done < <(list_autos)

  local all; all="$(
    for n in "${targets[@]}"; do quota_fetch "$n"; done \
      | jq -s --argjson map "$map" 'map(. + {active_in: ($map[.profile] // [])})')"
  if [ "$json" = 1 ]; then printf '%s\n' "$all"; return 0; fi

  local p st f5 r5 i5 f7 r7 i7 act e
  printf '%-12s %-6s %-26s %-6s %-26s %s\n' PROFILE 5H "5H RESETS" 7D "7D RESETS" ""
  # \x1f separator: tab is IFS-whitespace, so read would merge empty fields.
  while IFS=$'\x1f' read -r p st f5 r5 i5 f7 r7 i7 act e; do
    act="${act:+active: $act}"
    if [ "$st" != ok ]; then
      printf '%-12s %-6s %s  %s\n' "$p" "-" "$st: $e" "$act"; continue
    fi
    [ -n "$r5" ] && r5="$(date -d "$r5" '+%a %H:%M' 2>/dev/null) ($(fmt_in "$i5"))"
    [ -n "$r7" ] && r7="$(date -d "$r7" '+%a %d %b %H:%M' 2>/dev/null) ($(fmt_in "$i7"))"
    printf '%-12s %-6s %-26s %-6s %-26s %s\n' "$p" "${f5:+$f5%}" "${r5:--}" "${f7:+$f7%}" "${r7:--}" "$act"
  done < <(jq -r '.[] | [.profile, .status,
      (.five_hour.percent // "" | tostring | sub("\\.0$"; "")), (.five_hour.resets_at // ""), (.five_hour.resets_in_s // ""),
      (.seven_day.percent // "" | tostring | sub("\\.0$"; "")), (.seven_day.resets_at // ""), (.seven_day.resets_in_s // ""),
      (.active_in | join(",")), (.error // "")] | join("\u001f")' <<< "$all")
}

# ---------------------------------------------------------------------------
# Info / verification
# ---------------------------------------------------------------------------
# Print a profile's .claude directory — a self-contained CLAUDE_CONFIG_DIR that
# external, CLAUDE_CONFIG_DIR-aware tools (e.g. Paseo) can point at to discover
# that profile's account/auth WITHOUT going through the sandbox wrapper. e.g.:
#   export CLAUDE_CONFIG_DIR="$(claude-multi config-dir vcf-2)"
config_dir() {
  local name="${1:-}" do_export=0
  case "$name" in --export|-e) do_export=1; name="${2:-}" ;; esac
  [ -n "$name" ] || die "usage: claude-multi config-dir [--export] <profile>"
  valid_name "$name" || die "invalid profile name: '$name'"
  local d="$PROFILES_DIR/$name/.claude"
  [ -d "$d" ] || die "profile '$name' not initialized. Run: claude-multi init $name"
  if [ "$do_export" = 1 ]; then
    printf 'export CLAUDE_CONFIG_DIR=%q\n' "$d"
  else
    printf '%s\n' "$d"
  fi
}

list_profiles() {
  echo "Root:    $CLAUDE_MULTI_ROOT"
  echo "Shared:  $CLAUDE_MULTI_SHARED"
  echo "Config:  ${CLAUDE_MULTI_PROFILES:-<none persisted>}"
  echo "Profiles:"
  if [ -d "$PROFILES_DIR" ]; then
    local d name loggedin
    for d in "$PROFILES_DIR"/*/; do
      [ -d "$d" ] || continue
      name="$(basename "$d")"
      if logged_in "$name"; then loggedin="logged in"; else loggedin="not logged in"; fi
      printf '  - %-16s %s\n' "$name" "$loggedin"
    done
  else
    echo "  (none)"
  fi
  echo "Auto profiles (name -> active [members]):"
  auto_list
}

verify() {
  require_bwrap
  set +e  # we intentionally run commands expected to fail
  local tmproot; tmproot="$(mktemp -d "${TMPDIR:-/tmp}/claude-multi-verify.XXXXXX")"
  CLAUDE_MULTI_ROOT="$tmproot"
  PROFILES_DIR="$CLAUDE_MULTI_ROOT/profiles"
  SHARED_DIR="$CLAUDE_MULTI_ROOT/shared"
  CLAUDE_MULTI_SHARED="projects"
  CLAUDE_MULTI_CACHE=1
  CLAUDE_MULTI_PROFILES="a b"
  AUTO_DIR="$tmproot/auto"        # never touch the real auto state / wrappers
  BIN_DIR="$tmproot/bin"

  init_profile a >/dev/null
  init_profile b >/dev/null
  echo "A-only" > "$PROFILES_DIR/a/.claude/MARKER-A"
  echo "B-only" > "$PROFILES_DIR/b/.claude/MARKER-B"
  echo "shared" > "$SHARED_DIR/projects/MARKER-SHARED"
  printf 'PROFILE-A' > "$PROFILES_DIR/a/.claude/.claude.json"   # distinct identity per profile
  printf 'PROFILE-B' > "$PROFILES_DIR/b/.claude/.claude.json"

  local fail=0
  # Run the test command in a SUBSHELL so launch_in's `exec bwrap` replaces the
  # subshell, not this script.
  expect_ok()   { if ( launch_in "$2" bash -c "$3" ) >/dev/null 2>&1; then printf '  PASS  %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; fail=1; fi; }
  expect_fail() { if ( launch_in "$2" bash -c "$3" ) >/dev/null 2>&1; then printf '  FAIL  %s\n' "$1"; fail=1; else printf '  PASS  %s\n' "$1"; fi; }
  # Same, but run from $HOME to catch cwd-bind shadowing of the profile.
  expect_ok_home() { if ( cd "$HOME" && launch_in "$2" bash -c "$3" ) >/dev/null 2>&1; then printf '  PASS  %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; fail=1; fi; }

  echo "Running sandbox verification (no login required):"
  expect_ok   "1. A sees A-only marker"                  a '[ -f ~/.claude/MARKER-A ]'
  expect_fail "2. A does NOT see B-only marker"          a '[ -f ~/.claude/MARKER-B ]'
  expect_ok   "3. B sees B-only marker"                  b '[ -f ~/.claude/MARKER-B ]'
  expect_fail "   B does NOT see A-only marker"          b '[ -f ~/.claude/MARKER-A ]'
  expect_ok   "4a. A sees shared marker under projects"  a '[ -f ~/.claude/projects/MARKER-SHARED ]'
  expect_ok   "4b. B sees shared marker under projects"  b '[ -f ~/.claude/projects/MARKER-SHARED ]'
  expect_ok   "5. writes in project dir succeed"         a "touch '$PWD/.claude-multi-verify.tmp' && rm -f '$PWD/.claude-multi-verify.tmp'"
  expect_fail "6. writes to / (host root) fail"          a 'touch /claude-multi-should-fail'
  # Cross-account session visibility (proxy for test 8):
  ( launch_in a bash -c 'echo hi > ~/.claude/projects/XSESSION.jsonl' ) >/dev/null 2>&1
  expect_ok   "8*. projects file written by A is visible to B" b '[ -f ~/.claude/projects/XSESSION.jsonl ]'
  # .claude.json (account identity) isolation — the key auth-separation check.
  # It lives at $CLAUDE_CONFIG_DIR/.claude.json = ~/.claude/.claude.json.
  expect_ok   "9a. A sees its own .claude.json"          a '[ "$(cat ~/.claude/.claude.json)" = PROFILE-A ] && [ "$CLAUDE_CONFIG_DIR" = ~/.claude ]'
  expect_ok   "9b. B sees its own .claude.json"          b '[ "$(cat ~/.claude/.claude.json)" = PROFILE-B ]'
  # Identity must be WRITABLE via atomic temp+rename (how Claude saves it) — the
  # single-file-bind bug made this fail with EBUSY and froze the account.
  expect_ok   "9c. atomic rename to .claude.json works"  a 'cat ~/.claude/.claude.json > ~/.claude/.claude.json.tmp && mv -f ~/.claude/.claude.json.tmp ~/.claude/.claude.json'
  # Regression: launched from $HOME, the cwd bind must NOT re-expose the real
  # ~/.claude (would make every profile the same account).
  expect_ok_home "10a. identity isolated even when run from \$HOME (A)" a '[ "$(cat ~/.claude/.claude.json)" = PROFILE-A ] && [ -f ~/.claude/MARKER-A ]'
  expect_ok_home "10b. identity isolated even when run from \$HOME (B)" b '[ "$(cat ~/.claude/.claude.json)" = PROFILE-B ] && [ ! -f ~/.claude/MARKER-A ]'

  # Auto profiles / switch. Subshells: die() exits. --no-reload keeps paseo out.
  check() { if ( eval "$2" ) >/dev/null 2>&1; then printf '  PASS  %s\n' "$1"; else printf '  FAIL  %s\n' "$1"; fail=1; fi; }
  check "11a. auto create maps to first member"       'auto_create auto a b && [ "$(auto_resolve auto)" = a ] && [ -x "$BIN_DIR/claude-auto" ]'
  check "11b. auto name may not shadow a profile"     '! ( auto_create a b )'
  check "11c. auto members must be real profiles"     '! ( auto_create x a nope )'
  check "11d. switch refuses a not-logged-in member"  '! ( switch_profile auto b --no-reload )'
  echo '{"claudeAiOauth":{"refreshToken":"x"}}' > "$PROFILES_DIR/a/.claude/.credentials.json"
  echo '{"claudeAiOauth":{"refreshToken":"x"}}' > "$PROFILES_DIR/b/.claude/.credentials.json"
  check "11e. switch <auto> <member> sets it"         'switch_profile auto b --no-reload && [ "$(auto_resolve auto)" = b ]'
  check "11f. switch (no arg) rotates b -> a"         'switch_profile --no-reload && [ "$(auto_resolve auto)" = a ]'
  check "11g. switch <member> (sole auto) works"      'switch_profile b --no-reload && [ "$(auto_resolve auto)" = b ]'
  check "11h. switch rejects a non-member"            '! ( switch_profile auto nope --no-reload )'
  check "11i. re-create keeps active, wrapper -> run" 'auto_create auto && [ "$(auto_resolve auto)" = b ] && grep -q "run \"auto\"" "$BIN_DIR/claude-auto"'
  rm -f "$PROFILES_DIR/a/.claude/.credentials.json"
  check "11j. rotate skips logged-out members"        '! ( switch_profile auto --no-reload )'
  auto_put auto "a b" nope
  check "11k. stale active falls back to 1st member"  '[ "$(auto_resolve auto)" = a ]'
  auto_put auto "a b" b
  check "11l. run <auto> launches the active member"  \
    'CLAUDE_MULTI_BIN=bash run_profile auto -c "[ \"\$(cat ~/.claude/.claude.json)\" = PROFILE-B ]"'
  auto_put auto "a b" a
  check "11m. run <auto> follows a switch"            \
    'CLAUDE_MULTI_BIN=bash run_profile auto -c "[ \"\$(cat ~/.claude/.claude.json)\" = PROFILE-A ] && [ ! -f ~/.claude/MARKER-B ]"'
  check "11n. several autos: switch needs a name"     'auto_create other a b && ! ( switch_profile --no-reload )'
  echo '{"claudeAiOauth":{"accessToken":"","refreshToken":""}}' > "$PROFILES_DIR/b/.claude/.credentials.json"
  check "12a. blank tokens count as logged out"       '! logged_in b'
  check "12b. quota --json reports logged-out status" \
    '[ "$(quota_cmd b --json | jq -r ".[0].status")" = logged_out ]'
  check "12c. quota expands an auto to its members"   \
    '[ "$(quota_cmd auto --json | jq -r "map(.profile) | join(\" \")")" = "a b" ]'

  rm -rf "$tmproot"
  echo
  if [ "$fail" = 0 ]; then echo "All sandbox checks PASSED."; else echo "Some checks FAILED."; fi
  echo "Note: tests 7 (login isolation) and 8 (real session resume) require"
  echo "      logging two profiles in; see claude/multi/README.md."
  return $fail
}

usage() {
  cat <<EOF
claude-multi — multi-account Claude Code launcher (isolated auth, shared sessions)

Usage:
  claude-multi run <profile|auto> [args...]     Launch Claude as <profile> (an auto
                                                profile resolves to its active member)
  claude-multi auto create <name> [profiles...]  Create/update an AUTO profile: a virtual
                                                profile mapped onto real ones, launched via
                                                'run <name>' or the claude-<name> wrapper
  claude-multi auto [list] | auto rm <name>     List / remove auto profiles
  claude-multi switch [auto] [profile] [--no-reload]
                                                Point an auto profile at a member (no profile:
                                                rotate to the next logged-in one), then reload
                                                IDLE Paseo agents on provider claude-<auto>
                                                (when paseo is installed; --reload forces)
  claude-multi quota [profile|auto...] [--json] Show 5h / 7d usage + reset times per profile
                                                (all profiles by default; --json for scripts)
  claude-multi exec <profile> -- <cmd...>       Run any command in the sandbox
  claude-multi init <profile>                   Create empty profile state
  claude-multi import <profile> [opts]          Copy existing ~/.claude into a profile
       opts: --from DIR  --force  --seed-shared
  claude-multi link-main [subdirs...] [--all]   Share subdirs with the main, non-sandboxed
                                                ~/.claude (symlink; default: shared set)
  claude-multi unlink-main [subdirs...] [--copy] Detach them again (--copy keeps a snapshot)
  claude-multi list                             Show profiles / login status
  claude-multi config-dir [--export] <profile>  Print a profile's CLAUDE_CONFIG_DIR
                                                (for external tools, e.g. Paseo)
  claude-multi verify                           Run sandbox isolation self-test
  claude-multi where                            Print state paths
  claude-multi help

Config: $CONFIG_FILE
Root:   $CLAUDE_MULTI_ROOT   Shared: $CLAUDE_MULTI_SHARED
Autos:  $AUTO_DIR
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    run)     run_profile "$@" ;;
    auto)    auto_cmd "$@" ;;
    switch)  switch_profile "$@" ;;
    quota)   quota_cmd "$@" ;;
    exec)    exec_profile "$@" ;;
    init)    init_profile "${1:-}" ;;
    import)  import_profile "$@" ;;
    config-dir|configdir) config_dir "$@" ;;
    link-main)   link_main "$@" ;;
    unlink-main) unlink_main "$@" ;;
    list|ls) list_profiles ;;
    verify)  verify ;;
    where|path)
      echo "root=$CLAUDE_MULTI_ROOT"
      echo "profiles=$PROFILES_DIR"
      echo "shared=$SHARED_DIR"
      echo "config=$CONFIG_FILE"
      echo "autos=$AUTO_DIR" ;;
    help|-h|--help) usage ;;
    *) err "unknown command: $cmd"; usage; exit 2 ;;
  esac
}

main "$@"
